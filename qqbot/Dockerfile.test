ARG PYTHON_IMAGE=python:3.11-slim-bookworm@sha256:f06d01d4ba3f8ad5af45a3ec87df19c1d317d8e8961edc0fabda61811af6f7cf
FROM ${PYTHON_IMAGE}
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates fonts-noto-cjk nodejs && rm -rf /var/lib/apt/lists/*
COPY requirements/ requirements/
RUN pip install --no-cache-dir --timeout 120 --retries 5 --require-hashes -r requirements/dev.lock
COPY bot.py pyproject.toml run_webui.py ./
COPY plugins/ plugins/
COPY services/ services/
COPY infrastructure/ infrastructure/
COPY assets/ assets/
COPY webui/ webui/
COPY tests/ tests/
CMD ["python", "tests/run_checks.py"]
