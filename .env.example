# Copy required entries into the existing .env; do not overwrite real settings.
COMPOSE_PROJECT_NAME=qq_bot
BOT_QQ=
NAPCAT_ACCESS_TOKEN=
NAPCAT_WEBUI_TOKEN=
NAPCAT_WEBUI_PORT=6099
WEBUI_PORT=8765

# Tested immutable release inputs (2026-10-25).
NAPCAT_IMAGE=mlikiowa/napcat-docker@sha256:b101b8968cc31ae428ec0f8e117386e4ced7773b2d8226ed9f7ddfcec55f1b7e
PYTHON_IMAGE=python:3.11-slim-bookworm@sha256:f06d01d4ba3f8ad5af45a3ec87df19c1d317d8e8961edc0fabda61811af6f7cf
DOCKER_CLI_IMAGE=docker:29-cli@sha256:5e6baf67325a79f64ed3bed6863954d5e05d0f3d4e57cbdb14809346814bbfdb

LOG_LEVEL=INFO
CORE_SELFTEST_ENABLED=false
SUPERUSERS=[]
# Optional; empty means a random token is written to qqbot/storage/webui/management.token.
MANAGEMENT_ACCESS_TOKEN=
AUTO_CANDY_QQ=
AUTO_EMOJI_IDS=127852,12951
SONG_MAX_DOWNLOAD_MB=100
SONG_BASE64_UPLOAD_LIMIT_MB=35
SONG_STREAM_CHUNK_KB=256
SONG_CACHE_TTL_HOURS=24
SONG_SESSION_MINUTES=10
SONG_MUSIC_SOURCE=netease
SONG_BITRATE=320

# The password stays in qqbot/config/webui.env as WEBUI_PASSWORD=your-own-password.
# HOST_PROJECT_ROOT is supplied automatically by the containerized WebUI.
